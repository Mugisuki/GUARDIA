    h2{margin:0 0 6px; font-size:20px; letter-spacing:-.01em}
    .muted{color:var(--muted)}
    .section{padding:18px; border:1px solid var(--line); border-radius:var(--radius)}
    .kpis{display:grid; gap:12px}
    .kpi{display:grid; grid-template-columns:auto 1fr; gap:10px 12px; align-items:start}
    .kpi strong{font-weight:700}

    /* Timeline */
    .timeline{position:relative; display:grid; gap:14px; padding-left:18px}
    .timeline:before{content:""; position:absolute; left:4px; top:4px; bottom:4px; width:2px; background:linear-gradient(var(--accent), var(--accent2))}
    .entry{position:relative; padding-left:12px}
    .entry .dot{position:absolute; left:-2px; top:6px; width:10px; height:10px; border-radius:50%; background:linear-gradient(135deg, var(--accent), var(--accent2)); box-shadow:0 0 0 3px rgba(255,255,255,.07); animation:pulse 2.4s var(--ease) infinite}
    @keyframes pulse{0%,100%{box-shadow:0 0 0 3px rgba(255,255,255,.07)}50%{box-shadow:0 0 0 6px rgba(124,92,255,.18)}}

    /* Reveal on scroll */
    [data-reveal]{opacity:0; transform:translateY(18px); transition:opacity .6s var(--ease), transform .6s var(--ease)}
    [data-reveal].in{opacity:1; transform:none}

    /* Tilt */
    [data-tilt]{transition:transform .2s var(--ease)}

    /* Toast */
    .toast{position:fixed; left:50%; bottom:24px; transform:translateX(-50%) translateY(20px); opacity:0; background:var(--panel); border:1px solid var(--line); color:var(--text); padding:10px 14px; border-radius:999px; box-shadow:var(--shadow); transition:transform .25s var(--ease), opacity .25s var(--ease); z-index:60}
    .toast.show{opacity:1; transform:translateX(-50%) translateY(0)}

    /* Footer / Print */
    footer{color:var(--muted); text-align:center; padding:28px 0}
    @media print{ :root{--bg:#fff; --panel:#fff; --text:#111; --muted:#444; --line:#ccc; --shadow:none}
