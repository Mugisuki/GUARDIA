<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CV — Interactif & Animé</title>
  <meta name="description" content="CV HTML élégant, responsive, avec animations douces, interactions et prêt à imprimer." />
  <style>
    :root{
      --bg:#0a0e13; --panel:rgba(255,255,255,.06); --text:#e9eef6; --muted:#a7b2c3; --line:rgba(255,255,255,.12);
      --accent:#7c5cff; --accent2:#16c6ff; --radius:18px; --shadow:0 20px 60px rgba(0,0,0,.28);
      --ring:0 0 0 3px rgba(124,92,255,.35);
      --ease:cubic-bezier(.2,.8,.2,1);
    }
    [data-theme="light"]{ --bg:#f7f9fc; --panel:#fff; --text:#0b1020; --muted:#5a6476; --line:rgba(0,0,0,.1); --shadow:0 12px 40px rgba(30,35,50,.10) }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; font:16px/1.65 system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; color:var(--text);
      background:
        radial-gradient(1000px 700px at -10% 10%, rgba(22,198,255,.12), transparent 60%),
        radial-gradient(1100px 800px at 90% -10%, rgba(124,92,255,.13), transparent 60%),
        linear-gradient(180deg,#0a0c12,var(--bg));
      overflow-x:hidden;
    }
    a{color:inherit; text-decoration:none}
    img{max-width:100%; display:block}
    .wrap{width:min(1100px,94%); margin-inline:auto; padding:20px 0 80px}

    /* Appbar */
    .appbar{position:sticky; top:0; z-index:50; backdrop-filter:saturate(160%) blur(10px); -webkit-backdrop-filter:saturate(160%) blur(10px);
      background:linear-gradient(180deg, rgba(10,12,18,.65), transparent); border-bottom:1px solid var(--line)}
    [data-theme="light"] .appbar{background:rgba(255,255,255,.66)}
    .appbar-inner{display:flex; align-items:center; justify-content:space-between; padding:12px 0}
    .brand{display:flex; gap:10px; align-items:center; font-weight:800; letter-spacing:.3px}
    .brand svg{width:28px; height:28px}
    .actions{display:flex; gap:10px}
    .btn{display:inline-flex; align-items:center; gap:8px; padding:9px 14px; border-radius:999px; border:1px solid var(--line); background:transparent; color:inherit; cursor:pointer; font-weight:600; transition:transform .15s var(--ease), box-shadow .2s var(--ease)}
    .btn:hover{transform:translateY(-1px)}
    .btn:focus-visible{outline:none; box-shadow:var(--ring)}
    .btn--primary{border:none; color:#fff; background:linear-gradient(135deg,var(--accent),var(--accent2)); box-shadow:0 10px 28px rgba(124,92,255,.35)}

    /* Layout */
    .grid{display:grid; grid-template-columns:320px 1fr; gap:22px; margin-top:18px}
    @media (max-width:940px){ .grid{grid-template-columns:1fr} }
    .card{background:var(--panel); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); will-change:transform}
    .side{padding:22px; position:sticky; top:80px; align-self:start}
    .main{padding:22px; display:grid; gap:22px}

    /* Fancy background blob with parallax */
    .blob{position:fixed; inset:auto -120px 20% auto; width:520px; aspect-ratio:1; border-radius:50%; pointer-events:none; filter:blur(48px) saturate(140%); opacity:.28; z-index:0;
      background:radial-gradient(circle at 30% 30%, rgba(124,92,255,.65), transparent 55%), radial-gradient(circle at 70% 70%, rgba(22,198,255,.6), transparent 55%);
      transform:translate3d(0,0,0); transition:transform .2s var(--ease);
    }

    /* Sidebar */
    .photo{width:112px; height:112px; border-radius:50%; object-fit:cover; border:2px solid var(--line)}
    .name{font-size:28px; font-weight:800; letter-spacing:-.02em; margin-top:8px}
    .role{color:var(--muted); font-weight:700; min-height:1.4em}
    .type{background:linear-gradient(135deg,var(--accent),var(--accent2)); -webkit-background-clip:text; background-clip:text; color:transparent}

    .pill{display:inline-block; font-size:12px; padding:6px 10px; border-radius:999px; border:1px solid var(--line); background:rgba(255,255,255,.04); margin:6px 6px 0 0; transition:transform .12s var(--ease), background .2s var(--ease)}
    .pill:hover{transform:translateY(-2px); background:rgba(255,255,255,.08)}

    .list{list-style:none; padding:0; margin:8px 0; display:grid; gap:8px}
    .block + .block{margin-top:16px}

    .skills{display:grid; gap:12px}
    .bar{background:rgba(255,255,255,.07); border-radius:10px; overflow:hidden; border:1px solid var(--line); height:10px}
    .bar>span{display:block; height:100%; background:linear-gradient(90deg, var(--accent), var(--accent2)); width:0%}

    /* Sections */
    h2{margin:0 0 6px; font-size:20px; letter-spacing:-.01em}
    .muted{color:var(--muted)}
    .section{padding:18px; border:1px solid var(--line); border-radius:var(--radius)}
    .kpis{display:grid; gap:12px}
    .kpi{display:grid; grid-template-columns:auto 1fr; gap:10px 12px; align-items:start}
    .kpi strong{font-weight:700}

    /* Timeline */
    .timeline{position:relative; display:grid; gap:14px; padding-left:18px}
    .timeline:before{content:""; position:absolute; left:4px; top:4px; bottom:4px; width:2px; background:linear-gradient(var(--accent), var(--accent2))}
    .entry{position:relative; padding-left:12px}
    .entry .dot{position:absolute; left:-2px; top:6px; width:10px; height:10px; border-radius:50%; background:linear-gradient(135deg, var(--accent), var(--accent2)); box-shadow:0 0 0 3px rgba(255,255,255,.07); animation:pulse 2.4s var(--ease) infinite}
    @keyframes pulse{0%,100%{box-shadow:0 0 0 3px rgba(255,255,255,.07)}50%{box-shadow:0 0 0 6px rgba(124,92,255,.18)}}

    /* Reveal on scroll */
    [data-reveal]{opacity:0; transform:translateY(18px); transition:opacity .6s var(--ease), transform .6s var(--ease)}
    [data-reveal].in{opacity:1; transform:none}

    /* Tilt */
    [data-tilt]{transition:transform .2s var(--ease)}

    /* Toast */
    .toast{position:fixed; left:50%; bottom:24px; transform:translateX(-50%) translateY(20px); opacity:0; background:var(--panel); border:1px solid var(--line); color:var(--text); padding:10px 14px; border-radius:999px; box-shadow:var(--shadow); transition:transform .25s var(--ease), opacity .25s var(--ease); z-index:60}
    .toast.show{opacity:1; transform:translateX(-50%) translateY(0)}

    /* Footer / Print */
    footer{color:var(--muted); text-align:center; padding:28px 0}
    @media print{ :root{--bg:#fff; --panel:#fff; --text:#111; --muted:#444; --line:#ccc; --shadow:none}
      body{background:#fff}
      .appbar, .btns-print-hide{display:none !important}
      .grid{grid-template-columns:1fr 2.2fr}
      .wrap{width:210mm; padding:0; margin:0 auto}
      .card{box-shadow:none}
      a{text-decoration:underline}
      .blob{display:none}
    }
    @media (prefers-reduced-motion: reduce){
      *{animation:none !important; transition:none !important}
    }
  </style>
</head>
