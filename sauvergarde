  <footer class="wrap">© <span id="year"></span> — CV interactif</footer>
  <div class="toast" id="toast">Email copié !</div>

  <script>
    // Année
    document.getElementById('year').textContent = new Date().getFullYear();

    // Thème clair/sombre
    const saved = localStorage.getItem('cv-theme');
    const apply = m => m==='light' ? document.documentElement.setAttribute('data-theme','light') : document.documentElement.removeAttribute('data-theme');
    apply(saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light':'dark'));
    document.getElementById('theme').onclick = () => {
      const light = document.documentElement.getAttribute('data-theme')==='light';
      const next = light ? 'dark' : 'light';
      localStorage.setItem('cv-theme', next); apply(next);
    };

    // Typewriter effect for role
    const rolePhrases = [
      'Étudiant Informatique & Cyber',
      'Développeur Roblox',
      'Réseau & Sécurité (pfSense, VLAN, ACL)'
    ];
    const typeEl = document.getElementById('type');
    let pi=0, ci=0, del=false;
    function typeLoop(){
      const t = rolePhrases[pi % rolePhrases.length];
      ci += del ? -1 : 1;
      typeEl.textContent = t.slice(0, Math.max(0, ci));
      if(!del && ci===t.length){ del = true; setTimeout(typeLoop, 1200); return; }
      if(del && ci===0){ del = false; pi++; }
      setTimeout(typeLoop, del ? 40 : 60);
    }
    typeLoop();

    // IntersectionObserver: reveal + animated skill bars
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){ e.target.classList.add('in');
          // skill bars inside
          e.target.querySelectorAll('.bar > span[data-width]')?.forEach(sp=>{
            sp.style.width = sp.getAttribute('data-width');
          });
          io.unobserve(e.target);
        }
      })
    }, { threshold:.12 });
    document.querySelectorAll('[data-reveal]').forEach(el=> io.observe(el));

    // Tilt effect (subtle)
    const prefersReduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function attachTilt(el){
      if(prefersReduced) return;
      let rAF;
      const onMove = (e)=>{
        const b = el.getBoundingClientRect();
        const cx = e.clientX - b.left, cy = e.clientY - b.top;
        const rx = ((cy/b.height)-.5)*6; // tilt X
        const ry = ((cx/b.width)-.5)*-6; // tilt Y
        cancelAnimationFrame(rAF);
        rAF = requestAnimationFrame(()=>{
          el.style.transform = `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg) translateZ(0)`;
        });
      };
      const reset = ()=>{ el.style.transform = ''; };
      el.addEventListener('mousemove', onMove);
      el.addEventListener('mouseleave', reset);
    }
    document.querySelectorAll('[data-tilt]').forEach(attachTilt);

    // Parallax blob
    const blob = document.querySelector('.blob');
    window.addEventListener('mousemove', (e)=>{
      if(prefersReduced) return;
      const x = (e.clientX / window.innerWidth - .5) * 40;
      const y = (e.clientY / window.innerHeight - .5) * 30;
      blob.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    });

    // Copy email with toast
    const emailNode = document.querySelector('#emailVal a');
    const toast = document.getElementById('toast');
    document.getElementById('copyEmail').addEventListener('click', async ()=>{
      try{
        await navigator.clipboard.writeText(emailNode.textContent.trim());
        toast.classList.add('show');
        setTimeout(()=> toast.classList.remove('show'), 1400);
      }catch{ /* ignore */ }
    });
  </script>
</body>
</html>
